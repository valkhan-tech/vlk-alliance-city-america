# Configuração SMTP para envio do formulário de contato
# Copie este arquivo para ".env" e preencha com os dados reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=contato@alliancecityamerica.com.br
SMTP_PASSWORD=troque-esta-senha
SMTP_AUTH=true

# Remetente usado no envio (deve pertencer ao domínio autenticado no SMTP)
MAIL_FROM=contato@alliancecityamerica.com.br
MAIL_FROM_NAME="Alliance City América - Site"

# Destinatário(s) que recebem os leads do formulário. Separe múltiplos e-mails por vírgula.
MAIL_TO=contato@alliancecityamerica.com.br
MAIL_TO_NAME="Alliance City América"

# Assunto do e-mail enviado para a equipe
MAIL_SUBJECT="Novo lead pelo site - Alliance City América"

# Tempo mínimo (em segundos) que o formulário deve permanecer aberto antes do envio.
# Envios mais rápidos que isso são tratados como bots e recusados silenciosamente.
MIN_FILL_SECONDS=4
